{
  "name": "@repo/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants/api": {
      "default": "./dist/constants/api.js",
      "types": "./dist/constants/api.d.ts"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/text": {
      "types": "./dist/components/text.d.ts",
      "default": "./dist/components/text.js"
    },
    "./components/input": {
      "types": "./dist/components/input.d.ts",
      "default": "./dist/components/input.js"
    },
    "./components/textarea": {
      "types": "./dist/components/textarea.d.ts",
      "default": "./dist/components/textarea.js"
    },
    "./components/set-password-input": {
      "types": "./dist/components/set-password-input.d.ts",
      "default": "./dist/components/set-password-input.js"
    },
    "./components/loader": {
      "types": "./dist/components/loader.d.ts",
      "default": "./dist/components/loader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && swc src -d dist --strip-leading-paths --copy-files",
    "lint": "pnpm -w exec eslint apps/shared/src",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset:dev": "prisma migrate reset --force",
    "db:seed:dev": "node ./dist/prisma/seed.js",
    "reset": "pnpm db:reset:dev && pnpm build && pnpm db:seed:dev",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "date-fns": "^4.4.0",
    "dotenv": "17.2.3",
    "lucide-react": "^1.74.0",
    "lucide-react-native": "^1.66.0",
    "pg": "8.17.2",
    "styled-components": "7.0.0-prerelease-20261110053101",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-native": ">=0.85.0",
    "react-native-svg": ">=15.15.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.11",
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "prisma": "7.3.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "^15.15.4",
    "tailwindcss": "^4.1.18"
  }
}
