{
  "name": "@repo/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants/api": {
      "default": "./dist/constants/api.js",
      "types": "./dist/constants/api.d.ts"
    },
    "./eslint": "./eslint.shared.mjs",
    "./tailwind": "./tailwind.config.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && swc src -d dist --strip-leading-paths",
    "lint": "eslint \"src/**/*.{ts,js,tsx,jsx}\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck",
    "lint:fix": "eslint \"src/**/*.{ts,js,tsx,jsx}\" --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset:dev": "prisma migrate reset --force",
    "db:seed:dev": "node ./dist/prisma/seed.js",
    "reset": "pnpm db:reset:dev && pnpm build && pnpm db:seed:dev",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "pg": "8.23.1"
  },
  "peerDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
