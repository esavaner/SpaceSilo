{
  "name": "@repo/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d build --strip-leading-paths",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node build/main.js",
    "dev": "pnpm build && concurrently -k \"swc src -d build --strip-leading-paths --watch\" \"node --watch --watch-path=build build/main.js\"",
    "debug": "pnpm build && concurrently -k \"swc src -d build --strip-leading-paths --watch\" \"node --inspect --watch --watch-path=build build/main.js\"",
    "lint": "eslint \"src/**/*.{ts,js,tsx,jsx}\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck",
    "lint:fix": "eslint \"src/**/*.{ts,js,tsx,jsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@repo/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.3",
    "dotenv": "^18.0.9",
    "exifr": "^7.1.3",
    "fs-extra": "^11.4.1",
    "mime": "^4.1.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
