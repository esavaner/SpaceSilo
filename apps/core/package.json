{
  "name": "@repo/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d build --strip-leading-paths",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node build/main.js",
    "dev": "pnpm build && concurrently -k \"swc src -d build --strip-leading-paths --watch\" \"node --watch --watch-path=build build/main.js\"",
    "debug": "pnpm build && concurrently -k \"swc src -d build --strip-leading-paths --watch\" \"node --inspect --watch --watch-path=build build/main.js\"",
    "lint": "eslint \"src/**/*.{ts,js,tsx,jsx}\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck",
    "lint:fix": "eslint \"src/**/*.{ts,js,tsx,jsx}\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@repo/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron-parser": "^5.10.3",
    "exifr": "^7.1.3",
    "fs-extra": "^11.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6"
  }
}
