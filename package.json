{
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "build:core": "pnpm --filter @repo/shared --filter @repo/core build",
    "reset": "pnpm --filter @repo/shared reset",
    "start:core": "pnpm build:core && pnpm --filter @repo/core start",
    "clean": "node -e \"for (const p of ['node_modules','apps/core/node_modules','apps/core/build','apps/shared/node_modules','apps/shared/dist','apps/native/node_modules','apps/native/dist','apps/native/.expo']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @repo/shared build && pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "name": "root",
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
