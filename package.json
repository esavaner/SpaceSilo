{
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "build:core": "pnpm --filter @repo/shared --filter @repo/core build",
    "reset": "pnpm --filter @repo/shared reset",
    "start:core": "pnpm build:core && pnpm --filter @repo/core start",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @repo/shared build && pnpm -r --if-present typecheck",
    "check": "pnpm -r --if-present check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "name": "root",
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
